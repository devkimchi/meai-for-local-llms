      "ApiKey": "{{AZURE_OPENAI_API_KEY}}",
      "DeploymentName": "gpt-5-mini"
    }
  },

  "DockerModelRunner": {
    "BaseUrl": "http://localhost:12434/engines/v1",
    "Model": "ai/qwen3"
  },

  "FoundryLocal": {
    "Alias": "qwen2.5-0.5b"
  },

  "GitHub": {
