      "Endpoint": "https://models.github.ai/inference",
      "Token": "{{GITHUB_PAT}}",
      "Model": "openai/gpt-5-mini"
    }
  },

  "HuggingFace": {
    "BaseUrl": "http://localhost:11434",
    "Model": "hf.co/Qwen/Qwen3-1.7B-GGUF"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
